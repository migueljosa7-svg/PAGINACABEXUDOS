# =============================================================================
# PAGINACABEXUDOS - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
# For local development:
#   cp .env.example .env
#   # Edit .env with your values
# =============================================================================

# =============================================================================
# Frontend (Vite)
# =============================================================================

# WebSocket URL of the GPS Relay Server.
# When using the integrated server (server.js), leave empty to use same origin.
# For local development: leave empty (uses same origin)
# For production: leave empty (uses same origin)
# VITE_WS_RELAY_URL=

# Viewer transport for /gps-live (built into the bundle by Vite):
#   sse (default) -> GET /api/stream/location (stream 1:N, miles de espectadores)
#   ws            -> receiver WebSocket legacy (1:1)
# VITE_VIEWER_TRANSPORT=sse

# Read-only viewer token for /gps-live. Must be one of the AUTHORIZED_GPS_DEVICES
# entries; if missing the viewer does NOT connect (fail-secure).
# VITE_GPS_TOKEN=

# =============================================================================
# GPS Relay Server
# =============================================================================

# Port for the server (default: 3001, Render uses $PORT)
PORT=3001

# Log level: debug | info | warn | error
LOG_LEVEL=info

# CORS origin for the health endpoint (default: *)
CORS_ORIGIN=*

# Room cleanup interval in ms (default: 60000 = 1 minute)
CLEANUP_INTERVAL=60000

# Room idle TTL before cleanup in ms (default: 300000 = 5 minutes)
ROOM_IDLE_TTL=300000

# Anti-DoS limits (v3.1): max simultaneous WebSocket connections accepted per
# client IP and globally. Excess connections are closed with code 4008 BEFORE
# authentication. Decrement happens on socket close (refcount, no leaks).
# MAX_CONN_PER_IP=10
# MAX_TOTAL_CLIENTS=500

# Authorized GPS devices (JSON format) — REQUIRED in production via environment.
# Formato de token admitido: alfanumerico, guiones y guiones bajos, 3-128 chars
# (ej. "cmp_prueba_barrio" o el hex de 64 chars que genera `npm run generate-env`).
# El token debe estar REGISTRADO aqui: validar el formato no autoriza a nadie.
# Ejemplo: {"<64-hex-token>": {"name": "Recorrido Oficial"}}
# AUTHORIZED_GPS_DEVICES={"<token>": true}

# Tokens de DEMOSTRACION, separados de la lista de produccion (lista separada por
# comas, "token" o "token:etiqueta"). Sirve para abrir el enlace directo
# /gps-emisor?token=cmp_prueba_barrio SIN editar el JSON de produccion.
# Si no se define, el sistema sigue siendo fail-secure (4001).
# Quitala cuando la demo termine.
# GPS_DEMO_TOKENS=cmp_prueba_barrio:Comparsa San Jose (demo)

# Geofence municipal (Zaragoza). Los emisores fuera de este bbox se descartan.
# GEOFENCE_MIN_LAT=41.4
# GEOFENCE_MAX_LAT=41.8
# GEOFENCE_MIN_LNG=-1.1
# GEOFENCE_MAX_LNG=-0.7

# Rate-limiting (anti-saturacion). 0 = desactiva el limite.
# GPS_MIN_INTERVAL_MS=1000        # 1 paquete de ubicacion por emisor y segundo
# GPS_RATE_VIOLATION_BUDGET=5     # rafagas toleradas antes de expulsar con 4029
# GPS_PACKETS_PER_IP_PER_MIN=120  # tope agregado por IP de origen
# SSE_VIEWER_PER_IP_PER_MIN=60    # streams SSE abiertos por IP y minuto

# Health endpoint token. If set, /health?key=<token> shows room stats (hashed);
# without key it returns only {status, timestamp}.
# HEALTH_TOKEN=
